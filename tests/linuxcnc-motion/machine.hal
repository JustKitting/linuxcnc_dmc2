# Real LinuxCNC 2.9.10 motion-consumer acceptance machine.
#
# This machine never loads HostMot2 and therefore cannot address the physical
# CNC.  It does load the deployed dmc2_rt module, the deployed userspace
# bridges, LinuxCNC's real motmod, and LinuxCNC's real software step generator.
# The measured result is joint.N.motor-pos-cmd and stepgen.N.counts; neither is
# writable by the acceptance runner.

loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT base_period_nsec=[EMCMOT]BASE_PERIOD servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt stepgen step_type=0,0,0 ctrl_type=p,p,p
loadrt conv_s32_float count=3
loadrt mult2 count=3
loadrt watchdog num_inputs=1
loadrt estop_latch
loadrt flipflop names=acceptance-limit-latch-0,acceptance-limit-latch-1,acceptance-limit-latch-2
loadrt or2 names=acceptance-limit-recovery-owned
loadrt not names=acceptance-limit-recovery-inactive
loadrt and2 names=acceptance-hard-limit-0,acceptance-hard-limit-1,acceptance-hard-limit-2,acceptance-controller-watchdog-and
loadrt dmc2_rt

loadusr -Wn dmc2-pendant [DMC2_ACCEPTANCE]SERIAL_BRIDGE --component dmc2-pendant --port [DMC2_ACCEPTANCE]PENDANT_PORT --baud 115200 --packet-timeout-ms 100
loadusr -Wn dmc2-task-monitor [DMC2_ACCEPTANCE]TASK_MONITOR --component dmc2-task-monitor --error-journal [DMC2_ACCEPTANCE]ERROR_JOURNAL --diagnostic-journal [DMC2_ACCEPTANCE]DIAGNOSTIC_JOURNAL

# Capture downstream step-generator feedback before policy observes it.
addf stepgen.make-pulses base-thread
addf stepgen.capture-position servo-thread
addf conv-s32-float.0 servo-thread
addf conv-s32-float.1 servo-thread
addf conv-s32-float.2 servo-thread
addf mult2.0 servo-thread
addf mult2.1 servo-thread
addf mult2.2 servo-thread
addf acceptance-limit-latch-0 servo-thread
addf acceptance-limit-latch-1 servo-thread
addf acceptance-limit-latch-2 servo-thread
addf dmc2-pendant-control.update servo-thread
addf acceptance-limit-recovery-owned servo-thread
addf acceptance-limit-recovery-inactive servo-thread
addf acceptance-hard-limit-0 servo-thread
addf acceptance-hard-limit-1 servo-thread
addf acceptance-hard-limit-2 servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
addf stepgen.update-freq servo-thread
addf watchdog.set-timeouts servo-thread
addf watchdog.process servo-thread
addf acceptance-controller-watchdog-and servo-thread
addf estop-latch.0 servo-thread

# LinuxCNC's simulated plant is the same position-mode boundary used by the
# Mesa step generators: joint command -> step generator -> joint feedback.
setp stepgen.0.position-scale 1000
setp stepgen.1.position-scale 1000
setp stepgen.2.position-scale 1000
setp stepgen.0.maxvel 33
setp stepgen.1.maxvel 33
setp stepgen.2.maxvel 33
setp stepgen.0.maxaccel 0
setp stepgen.1.maxaccel 0
setp stepgen.2.maxaccel 0
setp mult2.0.in1 0.001
setp mult2.1.in1 0.001
setp mult2.2.in1 0.001

# X / JOINT_0 -> physical motor 1 / simulated stepgen 1.
net dmc2-x-enable joint.0.amp-enable-out => stepgen.1.enable
net dmc2-x-position-command joint.0.motor-pos-cmd => stepgen.1.position-cmd
net dmc2-x-count-s32 stepgen.1.counts => conv-s32-float.1.in
net dmc2-x-count-float conv-s32-float.1.out => mult2.1.in0
net dmc2-x-stepgen-position-feedback mult2.1.out => joint.0.motor-pos-fb

# Y / JOINT_1 -> physical motor 0 / simulated stepgen 0.
net dmc2-y-enable joint.1.amp-enable-out => stepgen.0.enable
net dmc2-y-position-command joint.1.motor-pos-cmd => stepgen.0.position-cmd
net dmc2-y-count-s32 stepgen.0.counts => conv-s32-float.0.in
net dmc2-y-count-float conv-s32-float.0.out => mult2.0.in0
net dmc2-y-stepgen-position-feedback mult2.0.out => joint.1.motor-pos-fb

# Z / JOINT_2 -> physical motor 2 / simulated stepgen 2.
net dmc2-z-enable joint.2.amp-enable-out => stepgen.2.enable
net dmc2-z-position-command joint.2.motor-pos-cmd => stepgen.2.position-cmd
net dmc2-z-count-s32 stepgen.2.counts => conv-s32-float.2.in
net dmc2-z-count-float conv-s32-float.2.out => mult2.2.in0
net dmc2-z-stepgen-position-feedback mult2.2.out => joint.2.motor-pos-fb

# Standard LinuxCNC simulated tool I/O loops. E-stop uses the same canonical
# latch, supervisor gate, heartbeat watchdog, and HALUI acknowledgement route
# as the physical profile below.
net tool-prep-loop iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
net tool-change-loop iocontrol.0.tool-change => iocontrol.0.tool-changed

# Attach the same production source and motion contracts used by live/pendant.hal.
net dmc2-motion-enabled motion.motion-enabled
source [DMC2_ACCEPTANCE]INPUT_SOURCES_HAL
source [DMC2_ACCEPTANCE]MOTION_CONTRACT_HAL

# Static non-motion prerequisites.  Motion state, task state, pendant state,
# position, counts, and wheel-jog acknowledgement remain real producers.
setp dmc2-pendant-control.servo-thread-ready true
setp dmc2-pendant-control.mesa-watchdog-has-bit false
setp dmc2-pendant-control.mesa-packet-error false
setp dmc2-pendant-control.mesa-packet-error-total 0
setp dmc2-pendant-control.mesa-packet-error-exceeded false
setp dmc2-pendant-control.ui-ready true
setp dmc2-pendant-control.pendant-mode-enabled true
newsig acceptance-limit-raw-0 bit
newsig acceptance-limit-raw-1 bit
newsig acceptance-limit-raw-2 bit
sets acceptance-limit-raw-0 false
sets acceptance-limit-raw-1 false
sets acceptance-limit-raw-2 false

# Model the live profile's realtime limit latches. Each raw signal drives both
# the controller input and its latch set input in the same servo cycle; the
# acceptance runner cannot independently manipulate the retained latch.
net acceptance-limit-reset-0 dmc2-pendant-control.motor-0-limit-reset => acceptance-limit-latch-0.reset
net acceptance-limit-reset-1 dmc2-pendant-control.motor-1-limit-reset => acceptance-limit-latch-1.reset
net acceptance-limit-reset-2 dmc2-pendant-control.motor-2-limit-reset => acceptance-limit-latch-2.reset
net acceptance-limit-latched-0 acceptance-limit-latch-0.out => dmc2-pendant-control.motor-0-limit-latched
net acceptance-limit-latched-1 acceptance-limit-latch-1.out => dmc2-pendant-control.motor-1-limit-latched
net acceptance-limit-latched-2 acceptance-limit-latch-2.out => dmc2-pendant-control.motor-2-limit-latched

# Reproduce the live native-hard-limit boundary. The raw limit remains visible
# to LinuxCNC except while the production controller owns an attributed jog,
# automatic backoff, or operator-commanded away recovery.
net acceptance-limit-raw-0 => dmc2-pendant-control.motor-0-limit-raw acceptance-limit-latch-0.set acceptance-hard-limit-0.in0
net acceptance-limit-raw-1 => dmc2-pendant-control.motor-1-limit-raw acceptance-limit-latch-1.set acceptance-hard-limit-1.in0
net acceptance-limit-raw-2 => dmc2-pendant-control.motor-2-limit-raw acceptance-limit-latch-2.set acceptance-hard-limit-2.in0
net acceptance-controller-jog-owned dmc2-pendant-control.jog-active => acceptance-limit-recovery-owned.in0
net acceptance-controller-bounce-owned dmc2-pendant-control.bounce-active => acceptance-limit-recovery-owned.in1
net acceptance-limit-recovery-owned-live acceptance-limit-recovery-owned.out => acceptance-limit-recovery-inactive.in
net acceptance-limit-recovery-inactive-live acceptance-limit-recovery-inactive.out => acceptance-hard-limit-0.in1 acceptance-hard-limit-1.in1 acceptance-hard-limit-2.in1
net acceptance-hard-limit-motor-0 acceptance-hard-limit-0.out => joint.1.pos-lim-sw-in
net acceptance-hard-limit-motor-1 acceptance-hard-limit-1.out => joint.0.pos-lim-sw-in
net acceptance-hard-limit-motor-2 acceptance-hard-limit-2.out => joint.2.pos-lim-sw-in

# Exercise the production software-watchdog handshake instead of forcing its
# acknowledgement pin high.
setp watchdog.timeout-0 0.100
net dmc2-controller-heartbeat dmc2-pendant-control.heartbeat => watchdog.input-0
net dmc2-controller-watchdog-enable dmc2-pendant-control.watchdog-enable => watchdog.enable-in
net dmc2-controller-watchdog-ok watchdog.ok-out => dmc2-pendant-control.software-watchdog-ok acceptance-controller-watchdog-and.in1

# Exact production E-stop topology. The physical pendant input drops the
# controller's external-enable output. That output and the heartbeat watchdog
# jointly feed LinuxCNC's one estop_latch; neither creates a second E-stop.
setp estop-latch.0.fault-in false
net dmc2-controller-external-enable dmc2-pendant-control.external-enable => acceptance-controller-watchdog-and.in0
net dmc2-external-estop-ok acceptance-controller-watchdog-and.out => estop-latch.0.ok-in
net dmc2-user-estop-reset iocontrol.0.user-request-enable => estop-latch.0.reset dmc2-pendant-control.base-estop-reset
net dmc2-estop-latched-ok estop-latch.0.ok-out => iocontrol.0.emc-enable-in
net dmc2-controller-estop-reset-request dmc2-pendant-control.estop-reset-request => halui.estop.reset
net dmc2-controller-machine-on-request dmc2-pendant-control.machine-on-request => halui.machine.on

# The physical machine ORs immediate stop with its limit gate.  With all test
# limits inactive, this direct connection is the identical controller path.
net dmc2-controller-jog-stop dmc2-pendant-control.jog-stop => motion.jog-stop
net dmc2-controller-jog-stop-immediate dmc2-pendant-control.jog-stop-immediate => motion.jog-stop-immediate
