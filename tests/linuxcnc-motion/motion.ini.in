[EMC]
MACHINE = DMC2 production motion acceptance
VERSION = 1.1
DEBUG = 0

[DISPLAY]
DISPLAY = linuxcncrsh --port @RSH_PORT@ --sessions 1 --path @RUN_DIRECTORY@
CYCLE_TIME = 0.050

[RS274NGC]
PARAMETER_FILE = @RUN_DIRECTORY@/sim.var

[EMCMOT]
EMCMOT = motmod
COMM_TIMEOUT = 4.0
BASE_PERIOD = 10000
SERVO_PERIOD = 1000000

[TASK]
TASK = milltask
CYCLE_TIME = 0.001

[HAL]
HALUI = halui
HALFILE = @PROJECT_ROOT@/tests/linuxcnc-motion/machine.hal

[HALUI]

[TRAJ]
NO_FORCE_HOMING = 1
AXES = 3
COORDINATES = X Y Z
HOME = 0 0 0
LINEAR_UNITS = mm
ANGULAR_UNITS = degree
DEFAULT_LINEAR_VELOCITY = 5.0
MAX_LINEAR_VELOCITY = 30.0

[EMCIO]
EMCIO = io
CYCLE_TIME = 0.100

[KINS]
KINEMATICS = trivkins
JOINTS = 3

[AXIS_X]
MIN_LIMIT = -500.0
MAX_LIMIT = 500.0
MAX_VELOCITY = 30.0
MAX_ACCELERATION = 50.0

[JOINT_0]
TYPE = LINEAR
HOME = 0.5
HOME_OFFSET = 0.0
HOME_SEARCH_VEL = 0.0
HOME_LATCH_VEL = 0.0
HOME_FINAL_VEL = 0.25
HOME_SEQUENCE = 0
MAX_VELOCITY = 30.0
MAX_ACCELERATION = 50.0
MIN_LIMIT = -500.0
MAX_LIMIT = 500.0
FERROR = 1.0
MIN_FERROR = 0.01

[AXIS_Y]
MIN_LIMIT = -500.0
MAX_LIMIT = 500.0
MAX_VELOCITY = 30.0
MAX_ACCELERATION = 50.0

[JOINT_1]
TYPE = LINEAR
HOME = 0.5
HOME_OFFSET = 0.0
HOME_SEARCH_VEL = 0.0
HOME_LATCH_VEL = 0.0
HOME_FINAL_VEL = 0.25
HOME_IGNORE_LIMITS = YES
HOME_SEQUENCE = 1
MAX_VELOCITY = 30.0
MAX_ACCELERATION = 50.0
MIN_LIMIT = -500.0
MAX_LIMIT = 500.0
FERROR = 1.0
MIN_FERROR = 0.01

[AXIS_Z]
MIN_LIMIT = -500.0
MAX_LIMIT = 500.0
MAX_VELOCITY = 30.0
MAX_ACCELERATION = 50.0

[JOINT_2]
TYPE = LINEAR
HOME = 0.0
MAX_VELOCITY = 30.0
MAX_ACCELERATION = 50.0
MIN_LIMIT = -500.0
MAX_LIMIT = 500.0
FERROR = 1.0
MIN_FERROR = 0.01

[DMC2_ACCEPTANCE]
PENDANT_PORT = @PENDANT_PORT@
SERIAL_BRIDGE = @PROJECT_ROOT@/native/bin/dmc2-serial-bridge
TASK_MONITOR = @PROJECT_ROOT@/native/bin/dmc2-task-monitor
ERROR_JOURNAL = @RUN_DIRECTORY@/error-channel.tsv
DIAGNOSTIC_JOURNAL = @RUN_DIRECTORY@/diagnostics.tsv
INPUT_SOURCES_HAL = @PROJECT_ROOT@/live/hal/pendant_input_sources.hal
MOTION_CONTRACT_HAL = @PROJECT_ROOT@/live/hal/pendant_motion_contract.hal
