%
(DMC2 HOMING-STYLE DOUBLE-TOUCH TOOL-HEIGHT TEST)
(VALUES APPROVED BY THE USER ON 2026-08-24.)
(X/Y remain at the recorded puck station. The spindle remains off.)
(The test must start at known machine Z home.)

#<puck_machine_x> = 288.125
#<puck_machine_y> = 152.955
#<puck_height_mm> = 19.40
#<z_home_machine> = 135.0
#<probe_target_z> = 0.0
#<fast_probe_feed_mm_min> = 300.0
#<backoff_distance_mm> = 1.0
#<backoff_feed_mm_min> = 15.0
#<slow_probe_feed_mm_min> = 15.0
#<position_tolerance_mm> = 0.010
#<connection_timeout_seconds> = 300.0

G21 G90 G94
G17 G40 G49 G80
M5

(This test must start at the recorded puck X/Y and known Z home.)
o<dmc2_double_touch_x_position> if [ABS[#<_abs_x> - #<puck_machine_x>] GT #<position_tolerance_mm>]
    (DEBUG,DMC2 DOUBLE TOUCH REFUSED: X is not at the recorded puck position)
    M2
o<dmc2_double_touch_x_position> endif
o<dmc2_double_touch_y_position> if [ABS[#<_abs_y> - #<puck_machine_y>] GT #<position_tolerance_mm>]
    (DEBUG,DMC2 DOUBLE TOUCH REFUSED: Y is not at the recorded puck position)
    M2
o<dmc2_double_touch_y_position> endif
o<dmc2_double_touch_z_home> if [ABS[#<_abs_z> - #<z_home_machine>] GT #<position_tolerance_mm>]
    (DEBUG,DMC2 DOUBLE TOUCH REFUSED: Z is not at known machine home)
    M2
o<dmc2_double_touch_z_home> endif

(Start with probe power off and the puck input open.)
M65 P0
M66 P1 L4 Q1.0
o<dmc2_double_touch_initial_power_off> if [#5399 LT 0]
    (DEBUG,DMC2 DOUBLE TOUCH REFUSED: OUT5 gate did not report off)
    M2
o<dmc2_double_touch_initial_power_off> endif
M66 P0 L0
o<dmc2_double_touch_initial_probe_open> if [#5399 NE 0]
    (DEBUG,DMC2 DOUBLE TOUCH REFUSED: puck input is already active)
    M2
o<dmc2_double_touch_initial_probe_open> endif

(MSG,DMC2 CONNECTION TEST GATE: no axis motion; resume, then touch the puck to the tool tip)
M0

(Recheck the locked position before the no-motion electrical connection test.)
o<dmc2_connection_test_x> if [ABS[#<_abs_x> - #<puck_machine_x>] GT #<position_tolerance_mm>]
    (DEBUG,DMC2 CONNECTION TEST REFUSED: X changed)
    M2
o<dmc2_connection_test_x> endif
o<dmc2_connection_test_y> if [ABS[#<_abs_y> - #<puck_machine_y>] GT #<position_tolerance_mm>]
    (DEBUG,DMC2 CONNECTION TEST REFUSED: Y changed)
    M2
o<dmc2_connection_test_y> endif
o<dmc2_connection_test_z> if [ABS[#<_abs_z> - #<z_home_machine>] GT #<position_tolerance_mm>]
    (DEBUG,DMC2 CONNECTION TEST REFUSED: Z changed)
    M2
o<dmc2_connection_test_z> endif
M66 P0 L0
o<dmc2_connection_test_initial_open> if [#5399 NE 0]
    (DEBUG,DMC2 CONNECTION TEST REFUSED: puck input is already active)
    M2
o<dmc2_connection_test_initial_open> endif

(Enable OUT5 for the no-motion manual connection test.)
M64 P0
M66 P1 L3 Q1.0
o<dmc2_connection_test_power_on> if [#5399 LT 0]
    M65 P0
    (DEBUG,DMC2 CONNECTION TEST FAILED: OUT5 gate did not report on)
    M2
o<dmc2_connection_test_power_on> endif
M66 P0 L0
o<dmc2_connection_test_powered_open> if [#5399 NE 0]
    M65 P0
    (DEBUG,DMC2 CONNECTION TEST FAILED: IN0 was active before the manual touch)
    M2
o<dmc2_connection_test_powered_open> endif

(MSG,DMC2 CONNECTION TEST ACTIVE: no axis motion; touch the puck to the installed tool tip)
M66 P0 L1 Q#<connection_timeout_seconds>
#<connection_result> = #5399
M65 P0
M66 P1 L4 Q1.0
o<dmc2_connection_test_power_off> if [#5399 LT 0]
    (DEBUG,DMC2 CONNECTION TEST FAILED: OUT5 gate did not report off)
    M2
o<dmc2_connection_test_power_off> endif
o<dmc2_connection_test_timeout> if [#<connection_result> LT 0]
    (DEBUG,DMC2 CONNECTION TEST FAILED: no IN0 contact within 300 seconds)
    M2
o<dmc2_connection_test_timeout> endif

(DEBUG,DMC2 CONNECTION TEST PASSED: IN0 contact detected and OUT5 removed)
(MSG,DMC2 CONNECTION PASSED: OUT5 OFF; place the puck, then resume to start tool measurement)
M0

(Recheck the locked position after the operator places the puck.)
o<dmc2_measure_confirmed_x> if [ABS[#<_abs_x> - #<puck_machine_x>] GT #<position_tolerance_mm>]
    (DEBUG,DMC2 TOOL MEASURE REFUSED: X changed)
    M2
o<dmc2_measure_confirmed_x> endif
o<dmc2_measure_confirmed_y> if [ABS[#<_abs_y> - #<puck_machine_y>] GT #<position_tolerance_mm>]
    (DEBUG,DMC2 TOOL MEASURE REFUSED: Y changed)
    M2
o<dmc2_measure_confirmed_y> endif
o<dmc2_measure_confirmed_z> if [ABS[#<_abs_z> - #<z_home_machine>] GT #<position_tolerance_mm>]
    (DEBUG,DMC2 TOOL MEASURE REFUSED: Z changed)
    M2
o<dmc2_measure_confirmed_z> endif
M66 P0 L0
o<dmc2_measure_probe_open_with_power_off> if [#5399 NE 0]
    (DEBUG,DMC2 TOOL MEASURE REFUSED: puck input is active while OUT5 is off)
    M2
o<dmc2_measure_probe_open_with_power_off> endif

(Enable the accepted OUT5 probe-power path only for the tool measurement.)
M64 P0
M66 P1 L3 Q1.0
o<dmc2_measure_power_on> if [#5399 LT 0]
    M65 P0
    (DEBUG,DMC2 TOOL MEASURE FAILED: OUT5 gate did not report on)
    M2
o<dmc2_measure_power_on> endif
M66 P0 L0
o<dmc2_measure_powered_probe_open> if [#5399 NE 0]
    M65 P0
    (DEBUG,DMC2 TOOL MEASURE FAILED: puck is already touching the tool or IN0 is active)
    M2
o<dmc2_measure_powered_probe_open> endif

(First touch: straight down at exactly 300 mm/min = 5 mm/s.)
G38.2 Z#<probe_target_z> F#<fast_probe_feed_mm_min>
#<first_probe_machine_z> = #5063

(Back off exactly 1.00 mm upward at exactly 15 mm/min = 0.25 mm/s.)
#<backoff_machine_z> = [#<first_probe_machine_z> + #<backoff_distance_mm>]
G53 G1 Z#<backoff_machine_z> F#<backoff_feed_mm_min>
M66 P0 L4 Q1.0
o<dmc2_double_touch_probe_cleared> if [#5399 LT 0]
    M65 P0
    (DEBUG,DMC2 DOUBLE TOUCH FAILED: IN0 did not clear during the 1.00 mm backoff)
    M2
o<dmc2_double_touch_probe_cleared> endif

(Second touch: straight down at exactly 15 mm/min = 0.25 mm/s.)
G38.2 Z#<probe_target_z> F#<slow_probe_feed_mm_min>
#<second_probe_machine_z> = #5063
#<repeat_difference_mm> = ABS[#<second_probe_machine_z> - #<first_probe_machine_z>]
#<plate_contact_machine_z> = [#<second_probe_machine_z> - #<puck_height_mm>]
#<tool_tip_height_at_home> = [#<z_home_machine> - #<plate_contact_machine_z>]

(Remove probe power before any return movement.)
M65 P0
M66 P1 L4 Q1.0
o<dmc2_double_touch_final_power_off> if [#5399 LT 0]
    (DEBUG,DMC2 DOUBLE TOUCH FAILED: OUT5 gate did not report off)
    M2
o<dmc2_double_touch_final_power_off> endif

(Conventional acceleration-limited rapid return to the known Z home.)
G53 G0 Z#<z_home_machine>

(DEBUG,DMC2 DOUBLE TOUCH PASSED: first probe machine Z = #<first_probe_machine_z> mm)
(DEBUG,DMC2 DOUBLE TOUCH: second probe machine Z = #<second_probe_machine_z> mm)
(DEBUG,DMC2 DOUBLE TOUCH: repeat difference = #<repeat_difference_mm> mm)
(DEBUG,DMC2 DOUBLE TOUCH: derived plate-contact machine Z = #<plate_contact_machine_z> mm)
(DEBUG,DMC2 DOUBLE TOUCH: tool-tip height at Z home = #<tool_tip_height_at_home> mm)
M2
%
