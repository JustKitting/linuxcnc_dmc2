# The two userspace processes below are bounded adapters only: one parses the
# Nano serial protocol and one reads LinuxCNC's native status channel. The
# compiled dmc2-pendant-control realtime component owns all policy. Finite
# motion is exchanged directly with LinuxCNC's servo-thread wheel-jog pins;
# HALUI is retained only for non-realtime machine-state requests.

loadusr -Wn dmc2-pendant ../native/bin/dmc2-process-supervisor --role serial-bridge --journal ../var/log/linuxcnc/process-lifecycle.tsv -- ../native/bin/dmc2-serial-bridge --component dmc2-pendant --port [DMC2]PENDANT_PORT --baud [DMC2]PENDANT_BAUD --packet-timeout-ms [DMC2]PENDANT_TIMEOUT_MS
loadusr -Wn dmc2-task-monitor ../native/bin/dmc2-process-supervisor --role task-monitor --journal ../var/log/linuxcnc/process-lifecycle.tsv -- ../native/bin/dmc2-task-monitor --component dmc2-task-monitor --error-journal ../var/log/linuxcnc/error-channel.tsv --diagnostic-journal ../var/log/linuxcnc/diagnostics.tsv

source hal/pendant_input_sources.hal

# Every externally visible component fault is decoded by the task monitor and
# written to the checksummed diagnostic journal with its stable identity,
# cause, operator action, source domain, retained raw value, and one coherent
# source-owned evidence snapshot. Unknown values remain explicitly unknown.
net dmc2-controller-fault-code dmc2-pendant-control.fault-code => dmc2-task-monitor.controller-fault-code-in
# The complete immutable first-fault capture travels with the controller code.
# This lets the task monitor journal the actual target/observed state, rather
# than requiring an operator to inspect or decode separate HAL pins afterward.
# Stable controller fault-data slots. Rust owns and tests the exact typed field
# mapped to every slot; these names are the bounded HAL transport ABI only.
net dmc2-ctl-fd-generation dmc2-pendant-control.fault-snapshot-generation => dmc2-task-monitor.ctl-fd-generation-in
net dmc2-ctl-fd-b00 dmc2-pendant-control.fault-data-b00 => dmc2-task-monitor.ctl-fault-data-b00-in
