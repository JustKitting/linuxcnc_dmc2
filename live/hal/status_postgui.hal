# AXIS/PyVCP wiring. This runs only after the PyVCP component exists.

# LinuxCNC-owned pendant motion supervisor.
net dmc2-pendant-mode-enabled axisui.pendant-mode-enabled => dmc2-pendant-control.pendant-mode-enabled
net dmc2-position-known           dmc2-pendant-control.position-known   => axisui.position-known
net dmc2-position-unknown         dmc2-pendant-control.position-unknown => axisui.position-unknown
net dmc2-controller-ready         => pyvcp.controller-ready
net dmc2-controller-fault         => axisui.controller-fault pyvcp.controller-fault
net dmc2-controller-recovery      => pyvcp.controller-recovery
net dmc2-controller-jog-active    => pyvcp.controller-jog-active
net dmc2-controller-bounce-active => pyvcp.controller-bounce-active

# Complete source-derived LinuxCNC 2.9.10 diagnostics. These indicators are
# observational; the existing native controller's fail-closed transport gate
# remains a separate signal.
net dmc2-linuxcnc-error-active dmc2-task-monitor.linuxcnc-error-active => pyvcp.linuxcnc-error-active
net dmc2-linuxcnc-warning-active dmc2-task-monitor.linuxcnc-warning-active => pyvcp.linuxcnc-warning-active
net dmc2-linuxcnc-unknown-code dmc2-task-monitor.unknown-code-active => pyvcp.linuxcnc-unknown-code

# HALUI performs the NML state changes outside the controller's 100 ms
# heartbeat loop.  Both requests are held until LinuxCNC status acknowledges
# the corresponding state and are forced low by every fail-closed path.
net dmc2-controller-estop-reset-request => halui.estop.reset
net dmc2-controller-machine-on-request  => halui.machine.on

# LinuxCNC machine-coordinate feedback (units are supplied by the final INI).
net dmc2-x-position halui.axis.x.pos-feedback => pyvcp.x-position
net dmc2-y-position halui.axis.y.pos-feedback => pyvcp.y-position
net dmc2-z-position halui.axis.z.pos-feedback => pyvcp.z-position

# Live RPM calculated from the H100 output-frequency readback. AXIS displays
# this beside its stock spindle controls even when the pendant panel is closed.
net dmc2-spindle-speed-feedback => axisui.spindle-actual-rpm
net dmc2-spindle-ready h100-spindle.ready => pyvcp.spindle-ready
net dmc2-spindle-communication-lost h100-spindle.block-kind-22 => pyvcp.spindle-communication-lost

# Pendant-panel hardware evidence. The three enable signals prove only that
# LinuxCNC has enabled the corresponding HostMot2 step output. They do not
# prove external driver power or physical motor response; no AL/ready input is
# assigned yet, and the UI labels that boundary explicitly.
net dmc2-mesa-packet-error-exceeded => pyvcp.mesa-packet-error-exceeded
net dmc2-mesa-watchdog-fault => pyvcp.mesa-watchdog-fault
net dmc2-x-enable => pyvcp.axis-x-output-enabled
net dmc2-y-enable => pyvcp.axis-y-output-enabled
net dmc2-z-enable => pyvcp.axis-z-output-enabled

# Mesa-generated pulse counts, converted to floats for PyVCP number widgets.
net dmc2-x-generated-pulses => pyvcp.x-generated-pulses
net dmc2-y-generated-pulses => pyvcp.y-generated-pulses
net dmc2-z-generated-pulses => pyvcp.z-generated-pulses

# Realtime live and display-only latched machine inputs.
net dmc2-limit-x-live    => pyvcp.limit-x-live
net dmc2-limit-y-live    => pyvcp.limit-y-live
net dmc2-limit-z-live    => pyvcp.limit-z-live
net dmc2-limit-x-latched => pyvcp.limit-x-latched
net dmc2-limit-y-latched => pyvcp.limit-y-latched
net dmc2-limit-z-latched => pyvcp.limit-z-latched
net dmc2-puck-live       => pyvcp.puck-live
net dmc2-probe-live      => pyvcp.probe-live
net dmc2-puck-latched    => pyvcp.puck-latched
net dmc2-probe-latched   => pyvcp.probe-latched
net dmc2-probe-power-enabled => pyvcp.probe-power-enabled

# AXIS owns these user toggles. Mode off clears Record in the UI and the
# realtime recorder also applies mode AND record on the same servo sample.
net dmc2-probe-mode-request axisui.probe-mode => dmc2-probe.mode-request
net dmc2-probe-record-request axisui.probe-record => dmc2-probe.record-request
net dmc2-probe-retry-save axisui.probe-retry-save => dmc2-probe-session.retry-save
net dmc2-probe-recorder-ready dmc2-probe-session.ready => axisui.probe-recorder-ready
net dmc2-probe-dropped dmc2-probe.dropped-samples => dmc2-probe-session.dropped-samples
net dmc2-manual-probe-selected => axisui.probe-selected
net dmc2-probe-live => axisui.probe-contact
net dmc2-probe-recording dmc2-probe.recording => axisui.probe-recording

# Preserve the program-running gate for the original G-code OUT5 path.
net dmc2-probe-program-running halui.program.is-running => dmc2-probe-power-gate.in1

# Clearing these five latches has no effect on a safety latch or motion state.
net dmc2-display-latch-reset pyvcp.clear-display-latches => dmc2-display-limit-x.reset dmc2-display-limit-y.reset dmc2-display-limit-z.reset dmc2-display-puck.reset dmc2-display-probe.reset

# Nano link and selector status. No pin below is connected to motion here.
net dmc2-pendant-connected        dmc2-pendant.connected        => pyvcp.pendant-connected
net dmc2-pendant-link-fault       dmc2-pendant.serial-fault     => pyvcp.pendant-link-fault
net dmc2-pendant-quadrature-fault dmc2-pendant.quadrature-fault => pyvcp.pendant-quadrature-fault
net dmc2-pendant-link-healthy     dmc2-pendant.link-healthy     => pyvcp.pendant-link-healthy
net dmc2-pendant-estop            dmc2-pendant.estop-pressed     => pyvcp.pendant-estop
net dmc2-pendant-deadman          dmc2-pendant.deadman-held      => pyvcp.pendant-deadman
net dmc2-pendant-selector-valid   dmc2-pendant.selector-valid    => pyvcp.pendant-selector-valid
net dmc2-pendant-axis-x           dmc2-pendant.axis-x            => pyvcp.pendant-axis-x
net dmc2-pendant-axis-y           dmc2-pendant.axis-y            => pyvcp.pendant-axis-y
net dmc2-pendant-axis-z           dmc2-pendant.axis-z            => pyvcp.pendant-axis-z
net dmc2-pendant-axis-4           dmc2-pendant.axis-4            => pyvcp.pendant-axis-4
net dmc2-pendant-axis-5           dmc2-pendant.axis-5            => pyvcp.pendant-axis-5
net dmc2-pendant-axis-off         dmc2-pendant.axis-off          => pyvcp.pendant-axis-off
net dmc2-pendant-multiplier-x1    dmc2-pendant.multiplier-x1     => pyvcp.pendant-multiplier-x1
net dmc2-pendant-multiplier-x10   dmc2-pendant.multiplier-x10    => pyvcp.pendant-multiplier-x10
net dmc2-pendant-multiplier-x100  dmc2-pendant.multiplier-x100   => pyvcp.pendant-multiplier-x100

# This is deliberately the final post-GUI operation. The controller keeps its
# external gate closed and its heartbeat watchdog in startup-rearm mode until
# AXIS/PyVCP wiring has completed.
setp dmc2-pendant-control.ui-ready true
