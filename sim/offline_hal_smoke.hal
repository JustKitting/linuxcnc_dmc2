# OFFLINE ONLY. This file loads no Mesa driver and opens no serial device.
loadrt threads name1=servo-thread period1=1000000
loadrt flipflop names=dmc2-display-limit-x,dmc2-display-limit-y,dmc2-display-limit-z,dmc2-display-puck,dmc2-display-probe
source status_sources.hal
source ../live/hal/status_latches.hal
source ../reference/hal/pendant_replay.hal
loadusr -Wn halui python3 ./mock_gui_hal.py
source ../live/hal/status_postgui.hal
start

# Give the realtime thread time to run, then prove a short synthetic input can
# remain visible in its display-history latch after the live signal clears.
loadusr -w /bin/sleep 0.05
sets dmc2-probe-live true
loadusr -w /bin/sleep 0.01
sets dmc2-probe-live false
loadusr -w /bin/sleep 0.01
show pin dmc2-pendant.connected
show pin dmc2-pendant.serial-fault
show pin dmc2-pendant.latest-detent
show pin dmc2-display-probe.out

unloadusr dmc2-pendant
unloadusr halui
stop
unloadrt all
