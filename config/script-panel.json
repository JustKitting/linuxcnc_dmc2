{
  "version": 1,
  "defaults": {
    "xyz-probe-reach-mm": {
      "value": "22",
      "description": "PGFUN XYZ probe nominal new stylus length, seating shoulder to ball bottom; editable reach default requested by the operator.",
      "source": "https://pgfuntransmission.com/wp-content/uploads/2024/11/6s-Nc.jpg"
    }
  },
  "scripts": [
    {
      "key": "tool-setter",
      "operation": "program.tool-setter-manual",
      "description": "Position the tool above the setter. Searches downward at 800 mm/min, backs off until released at 50 mm/min, then re-touches at 50 mm/min. Saves both contacts and stops after the slow touch. Z only; travel starts at the position when Run is pressed.",
      "parameters": [
        {"pin": "tool-setter-search-mm", "label": "Max downward travel", "kind": "positive-mm", "default": "25", "increment": "1"}
      ]
    },
    {
      "key": "block",
      "operation": "program.measure-gauge-block",
      "requires_beginning": true,
      "description": "Start clear above the block. Discovers its rotated footprint on a 1 mm grid, then double-touches the same side stations on three circuits 1 mm apart. Unexpected outside-edge Z contact retracts above the measured top and cancels. X: physical RIGHT / LinuxCNC -X; physical LEFT / LinuxCNC +X.",
      "parameters": [
        {"pin": "block-search-mm", "label": "Initial top search travel", "kind": "positive-mm", "default": "25", "increment": "1"},
        {"pin": "block-clearance-mm", "label": "Clearance above measured top", "kind": "positive-mm", "default": "2", "increment": "1"},
        {"pin": "block-drop-mm", "label": "Grid dip below first top", "kind": "positive-mm", "default": "1", "increment": "1"},
        {"pin": "block-side-depth-mm", "label": "First side ball-centre depth", "kind": "positive-mm", "default": "1", "increment": "1"}
      ]
    },
    {
      "key": "circle",
      "operation": "program.find-circle-center",
      "description": "Start clear inside the hole at probing height. XY only. X: physical RIGHT / LinuxCNC -X; physical LEFT / LinuxCNC +X.",
      "parameters": [
        {"pin": "circle-search-mm", "label": "Max travel / direction", "kind": "positive-mm", "default": "25", "increment": "1"}
      ]
    },
    {
      "key": "surface",
      "operation": "program.map-top-surface",
      "description": "Offsets start at the current XY. X positive: physical LEFT / LinuxCNC +X; X negative: physical RIGHT / LinuxCNC -X. Probe reach defaults to the configured PGFUN stylus specification and is editable.",
      "parameters": [
        {"pin": "surface-x-min-mm", "label": "X start offset", "kind": "signed-mm", "default": "0", "increment": "1"},
        {"pin": "surface-x-max-mm", "label": "X end offset", "kind": "signed-mm", "default": "0", "increment": "1"},
        {"pin": "surface-y-min-mm", "label": "Y start offset", "kind": "signed-mm", "default": "0", "increment": "1"},
        {"pin": "surface-y-max-mm", "label": "Y end offset", "kind": "signed-mm", "default": "0", "increment": "1"},
        {"pin": "surface-spacing-mm", "label": "Grid spacing", "kind": "positive-mm", "default": "0", "increment": "1"},
        {"pin": "surface-usable-reach-mm", "label": "Mounted usable reach", "kind": "positive-mm", "default": {"reference": "xyz-probe-reach-mm"}, "increment": "1"},
        {"pin": "surface-max-drop-mm", "label": "Maximum drop", "kind": "positive-mm", "default": "3", "increment": "1"},
        {"pin": "surface-reference-search-mm", "label": "Reference search travel", "kind": "positive-mm", "default": "3", "increment": "1"},
        {"pin": "surface-clearance-mm", "label": "Travel clearance", "kind": "positive-mm", "default": "2", "increment": "1"},
        {"pin": "surface-reach-reserve-mm", "label": "Probe reach reserve", "kind": "positive-mm", "default": "2", "increment": "1"}
      ]
    },
    {
      "key": "auto-map",
      "operation": "program.auto-map",
      "requires_beginning": true,
      "description": "Start clear above the block. Brackets the first edge, probes inward at the last top-contact Z, then follows local contacts around the outline at fixed Z. Trace step sets the local search radius; Outline resolution sets candidate spacing and closing-touch tolerance. X: physical RIGHT / LinuxCNC -X; physical LEFT / LinuxCNC +X.",
      "parameters": [
        {
          "pin": "auto-map-drop-mm",
          "label": "Maximum descent from starting Z",
          "kind": "positive-mm",
          "default": "12.7",
          "increment": "1"
        },
        {
          "pin": "auto-map-grid-mm",
          "label": "Trace step / local search radius",
          "kind": "positive-mm",
          "default": "1",
          "increment": "1"
        },
        {
          "pin": "auto-map-resolution-mm",
          "label": "Outline resolution",
          "kind": "positive-mm",
          "default": "0.1",
          "increment": "0.1"
        },
        {
          "pin": "auto-map-usable-reach-mm",
          "label": "Mounted usable probe reach",
          "kind": "positive-mm",
          "default": {"reference": "xyz-probe-reach-mm"},
          "increment": "1"
        },
        {
          "pin": "auto-map-reach-reserve-mm",
          "label": "Probe reach reserve",
          "kind": "positive-mm",
          "default": "2",
          "increment": "1"
        }
      ]
    },
    {
      "key": "rim",
      "operation": "program.rim",
      "requires_beginning": true,
      "description": "Start clear above the block. Uses the retained plate envelope, binary edge searches and an outward grid; verifies the fitted faces. Starting Z is the clearance ceiling; every dip stays within its original descent budget. Then touches around the sides, backing off at each station. X: physical RIGHT / LinuxCNC -X; physical LEFT / LinuxCNC +X.",
      "parameters": [
        {
          "pin": "rim-drop-mm",
          "label": "Maximum descent from starting Z",
          "kind": "positive-mm",
          "default": "12.7",
          "increment": "1"
        },
        {
          "pin": "rim-grid-mm",
          "label": "Grid / station spacing",
          "kind": "positive-mm",
          "default": "1",
          "increment": "1"
        },
        {
          "pin": "rim-resolution-mm",
          "label": "Boundary bracket resolution",
          "kind": "positive-mm",
          "default": "0.1",
          "increment": "0.1"
        },
        {
          "pin": "rim-usable-reach-mm",
          "label": "Mounted usable probe reach",
          "kind": "positive-mm",
          "default": {"reference": "xyz-probe-reach-mm"},
          "increment": "1"
        },
        {
          "pin": "rim-reach-reserve-mm",
          "label": "Probe reach reserve",
          "kind": "positive-mm",
          "default": "2",
          "increment": "1"
        },
        {
          "pin": "rim-side-depth-mm",
          "label": "Side ball-centre depth below top",
          "kind": "positive-mm",
          "default": "1",
          "increment": "1"
        },
        {
          "pin": "rim-backoff-mm",
          "label": "Side clearance beyond estimated edge",
          "kind": "positive-mm",
          "default": "2",
          "increment": "1"
        }
      ]
    }
  ]
}
